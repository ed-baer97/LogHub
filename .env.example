# Copy to .env in the repo root before `docker compose up`.

SECRET_KEY=change-me-to-a-long-random-string
POSTGRES_PASSWORD=change-me-strong-db-password
SUPERADMIN_PASSWORD=change-me-strong-admin-password

# Host port published by the postgres container (inside Docker the port stays 5432).
# Default is 5432. If a local PostgreSQL already owns 5432/5433, set another port:
# POSTGRES_HOST_PORT=15432
