# Скопируйте в .env в корне репозитория перед `docker compose up`.
# Локальный запуск без Docker эти переменные не требует (SQLite + дефолты в config.py).

SECRET_KEY=change-me-to-a-long-random-string
POSTGRES_PASSWORD=change-me-strong-db-password
SUPERADMIN_PASSWORD=change-me-strong-admin-password
